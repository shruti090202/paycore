# Copy to .env for local development (docker-compose provides Postgres + Redis). Never commit .env.
# In production every value is set in the Render / Vercel dashboards.

# Postgres: JDBC URL + user/password locally, or a postgresql://user:pass@host/db URL (Neon pooled string) in production.
DATABASE_URL=jdbc:postgresql://localhost:5432/paycore
DATABASE_USER=paycore
DATABASE_PASSWORD=paycore
# Neon direct (non-pooled) host for Flyway; leave unset locally.
DATABASE_DIRECT_URL=

# Redis: local docker-compose, or Upstash rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48 / 32 / 32 / hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_TTL_MINUTES=30
APP_ENCRYPTION_KEY=change-me-base64-32-bytes
CARD_FINGERPRINT_KEY=change-me-base64-32-bytes
INTERNAL_JOB_TOKEN=change-me-hex

# Demo merchant seeded on startup. DEMO_API_KEY must start with sk_test_; if empty a random one is printed once in the logs.
DEMO_MERCHANT_EMAIL=demo@paycore.dev
DEMO_MERCHANT_PASSWORD=demo-password-change-me
DEMO_API_KEY=

CHECKOUT_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SENTRY_DSN=
SPRING_PROFILES_ACTIVE=local
