# ---- PayCore API (api/) ----
# Copy to .env for local dev. docker-compose provides Postgres + Redis with these defaults.
# NEVER commit .env. In production every value below is set in the Render dashboard.

# Postgres. Either a JDBC URL + user/password (local), or a plain postgresql://user:pass@host/db URL as Neon
# hands it out (production: the POOLED string, host contains "-pooler").
DATABASE_URL=jdbc:postgresql://localhost:5432/paycore
DATABASE_USER=paycore
DATABASE_PASSWORD=paycore
# Flyway must use the DIRECT (non-pooled) Neon host: PgBouncer transaction pooling breaks migrations' session state.
# Production: DATABASE_DIRECT_URL=postgresql://... (direct host). Locally the app URL is fine (leave unset).
# DATABASE_DIRECT_URL=

# Redis (Lettuce). Locally: docker-compose. Production: Upstash "rediss://default:<password>@<host>:6379".
REDIS_URL=redis://localhost:6379

# HS256 secret for dashboard JWTs. >= 32 random bytes, base64. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Access token lifetime
JWT_TTL_MINUTES=30

# AES-256 key (base64, exactly 32 bytes) used to encrypt webhook signing secrets at rest. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me-base64-32-bytes

# Server-side HMAC key used to fingerprint test card numbers (never store PANs). Generate: openssl rand -base64 32
CARD_FINGERPRINT_KEY=change-me-base64-32-bytes

# Shared secret for /internal/jobs/* (called by GitHub Actions cron). Generate: openssl rand -hex 32
INTERNAL_JOB_TOKEN=change-me-hex

# Demo merchant. The seeder creates this merchant on startup if missing.
DEMO_MERCHANT_EMAIL=demo@paycore.dev
DEMO_MERCHANT_PASSWORD=demo-password-change-me
# Optional fixed API key for the demo store (must start with sk_test_). If unset, a random one is generated and printed ONCE in logs.
DEMO_API_KEY=

# Where the hosted checkout lives (Next.js). Used to build checkout_url on payments.
CHECKOUT_BASE_URL=http://localhost:3000
# Allowed browser origins for CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sentry (optional). Leave empty to disable.
SENTRY_DSN=

# Spring profile: local | prod
SPRING_PROFILES_ACTIVE=local

# ---- Web (web/) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Demo store server-side secrets (Vercel env in production)
PAYCORE_DEMO_SECRET_KEY=sk_test_...
PAYCORE_DEMO_WEBHOOK_SECRET=whsec_...
