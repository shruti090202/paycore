# Public: where the browser reaches the PayCore API (Render URL in production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Server-side only (never exposed to the browser): the demo store's merchant secret key and webhook signing secret.
# Get them from the dashboard (API keys / Webhooks -> reveal secret) for the demo merchant.
PAYCORE_DEMO_SECRET_KEY=sk_test_localdemo000000000000000000000000
PAYCORE_DEMO_WEBHOOK_SECRET=whsec_...
# Optional: server-side API base (e.g. an internal URL); defaults to NEXT_PUBLIC_API_BASE_URL
# PAYCORE_API_BASE_URL=
